# Surf Coach API
VITE_API_BASE_URL=http://localhost:8000

# Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Client-direct avatar uploads (session media goes through the API → surf-media)
VITE_SUPABASE_AVATAR_BUCKET=profile-media

# Google Analytics 4 measurement id (e.g. G-XXXXXXX). Leave empty to disable
# (analytics is a no-op in dev/local when unset).
VITE_GA_MEASUREMENT_ID=

# Sentry error monitoring. Leave empty to disable (no-op in dev/local).
VITE_SENTRY_DSN=

# Build-time source-map upload (optional, NOT VITE_-prefixed so they stay out of
# the client bundle). When SENTRY_AUTH_TOKEN is set, the Vite build uploads maps.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
